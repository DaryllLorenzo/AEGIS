{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "AppHost": {
    "Services": {
      // PostgreSQL is always started; the API cannot run without it.
      "Api": true,
      "Web": true,
      "PgAdmin": false,
      "MinIO": true
    },
    "Ports": {
      "Api": 5180,
      "Web": 3000,
      "MinIO": 9000,
      "MinIOConsole": 9001
    },
    "Web": {
      // "dev" = Next.js dev server with hot reload. "container" = build apps/web/Dockerfile.
      "Mode": "dev",
      // Set to false to skip `npm install` when dependencies are known to be current.
      "InstallPackages": true
    },
    "MinIO": {
      // Root credentials for local development only — never use these in production.
      "RootUser": "minioadmin",
      "RootPassword": "minioadmin"
    }
  }
}
