{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "MinIO": {
      // Overridden per environment. In development Aspire injects the real endpoint/credentials.
      // In production set these via environment variables: Storage__MinIO__Endpoint, etc.
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "UseSsl": false,
      "DefaultPresignedUrlExpiry": "01:00:00"
    }
  },
  "Scalar": {
    "Enabled": false,
    "RoutePrefix": "/scalar",
    "Title": "AEGIS API",
    "Theme": "Purple",
    "DefaultClientTarget": "CSharp",
    "DefaultClient": "HttpClient",
    "PersistAuthentication": true
  },
  "Jwt": {
    "Key": "AEGIS-SuperSecretKey-ChangeInProduction-2024!",
    "Issuer": "AegisApi",
    "Audience": "AegisWeb",
    "ExpiresInHours": "24"
  }
}
