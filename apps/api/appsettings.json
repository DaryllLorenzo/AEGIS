{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "MinIO": {
      // Overridden per environment. In development Aspire injects the real endpoint/credentials.
      // In production set these via environment variables: Storage__MinIO__Endpoint, etc.
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "UseSsl": false,
      "DefaultPresignedUrlExpiry": "01:00:00"
    }
  },
  "Scalar": {
    "Enabled": false,
    "RoutePrefix": "/scalar",
    "Title": "AEGIS API",
    "Theme": "Purple",
    "DefaultClientTarget": "CSharp",
    "DefaultClient": "HttpClient",
    "PersistAuthentication": true
  },
  "Email": {
    "Smtp": {
      // Leave Host empty to log-and-skip sends; set it per environment to actually send.
      "Host": "",
      "Port": 25,
      "From": "noreply@aegis.local",
      "EnableSsl": false
    }
  },
  "Jwt": {
    // No default signing key: it must come from the environment (Jwt__Key) or user
    // secrets. Startup fails fast if it is missing or shorter than 32 characters.
    "Key": "",
    "Issuer": "AegisApi",
    "Audience": "AegisWeb",
    "ExpiresInHours": "24",
    "RefreshExpiresInDays": "7"
  }
}
